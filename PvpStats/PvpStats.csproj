<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Authors>HanaSi0</Authors>
		<Company></Company>
		<Version>1.0.8</Version>
		<AssemblyName>CCStats</AssemblyName>
		<RootNamespace>PvpStats</RootNamespace>
		<Description>CCStats 水晶冲突数据记录与 3D 实时渲染回放</Description>
		<Copyright></Copyright>
		<PackageProjectUrl></PackageProjectUrl>
	</PropertyGroup>
	<ItemGroup>
        <Content Include="..\LICENSE.txt">
            <Link>LICENSE.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="..\images\icon.png">
            <Link>icon.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
	<ItemGroup>
		<Content Include="..\images\background\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</Content>
	</ItemGroup>
	<PropertyGroup>
		<PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="TerraFX.Interop.Windows" Private="false" />
		<EmbeddedResource Include="Resources/ReplayMaps/*.ccmap.gz" />
		<EmbeddedResource Include="Resources/ReplayMaps/*.ccwalk.gz" />
		<PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
		<PackageReference Include="LiteDB" Version="5.0.16" />
	</ItemGroup>
</Project>
