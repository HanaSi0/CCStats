    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../PvpStats/Resources/ReplayMaps/*.ccmap.gz" LogicalName="PvpStats.Resources.ReplayMaps.%(Filename)%(Extension)" />
