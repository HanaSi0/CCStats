    <Compile Include="../../PvpStats/Helpers/MatchQuery.cs" Link="MatchQuery.cs" />
    <Compile Include="../../PvpStats/Helpers/MatchVersionPolicy.cs" Link="MatchVersionPolicy.cs" />
    <Compile Include="../../PvpStats/Helpers/MatchHelper.cs" Link="MatchHelper.cs" />
