    <Compile Include="../../PvpStats/Helpers/ViewLayout.cs" Link="ViewLayout.cs" />
    <Compile Include="../../PvpStats/Helpers/EncounterStatistics.cs" Link="EncounterStatistics.cs" />
    <Compile Include="../../PvpStats/Helpers/ScoreboardSummary.cs" Link="ScoreboardSummary.cs" />
    <Compile Include="../../PvpStats/Types/Display/CCPlayerJobStats.cs" Link="CCPlayerJobStats.cs" />
