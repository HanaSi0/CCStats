<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PvpStats/Helpers/MatchQuery.cs" Link="Helpers/MatchQuery.cs" />
    <Compile Include="../PvpStats/Localization/*.cs" Link="Localization/%(Filename)%(Extension)" />
    <Compile Include="../PvpStats/Analysis/*.cs" Link="Analysis/%(Filename)%(Extension)" />
    <Compile Include="../PvpStats/Leaderboards/*.cs" Link="Leaderboards/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/result-column-labels.json" LogicalName="CCStats.ResultColumnLabels.json" />
    <EmbeddedResource Include="Resources/action-names.json" LogicalName="CCStats.ActionNames.json" />
    <EmbeddedResource Include="Resources/client-identities.json" LogicalName="CCStats.ClientIdentities.json" />
    <EmbeddedResource Include="../docs/exports/official-maps-2d/assets.json" LogicalName="CCStats.MapMetadata.json" />
    <EmbeddedResource Include="../PvpStats/Resources/ReplayMaps/*.gz" LogicalName="PvpStats.Resources.ReplayMaps.%(Filename)%(Extension)" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
    <PackageReference Include="LiteDB" Version="5.0.16" />
  </ItemGroup>
</Project>
