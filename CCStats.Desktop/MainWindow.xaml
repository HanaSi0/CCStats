<Window x:Class="CCStats.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCstats" Width="1180" Height="780" MinWidth="860" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,4,0,24">
          <Image Source="Assets/icon.png" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,14"/>
          <TextBlock Text="CCstats" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"/></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="6,5,0,22">
        <TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold"/>
      </StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Margin="6,0,8,0"/>
      </ScrollViewer>

    </Grid>
  </Grid>
</Window>
