<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CCStats.Desktop</AssemblyName>
    <Version Condition="'$(CCStatsEdition)' != 'China'">0.1.3</Version>
    <Version Condition="'$(CCStatsEdition)' == 'China'">0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Authors>HanaSi0</Authors>
    <ApplicationIcon>../images/desktop.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MainWindow.Rankings.cs" Condition="'$(CCStatsEdition)' == 'China'" />
    <Compile Remove="MainWindow.Rankings.Disabled.cs" Condition="'$(CCStatsEdition)' != 'China'" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../CCStats.Core/CCStats.Core.csproj" />
    <Resource Include="../docs/exports/official-maps-2d/images/*.png" Link="Assets/Maps/%(Filename)%(Extension)" />
    <Resource Include="../images/icon.png" Link="Assets/icon.png" />
    <Content Include="README-CN.txt" Condition="'$(CCStatsEdition)' == 'China'" Link="README.txt" TargetPath="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Condition="'$(CCStatsEdition)' != 'China'" Include="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lumina" Version="6.5.1" />
  </ItemGroup>
</Project>
